{
  "name": "asteroids-game",
  "version": "1.0.0",
  "description": "A modern implementation of the classic Asteroids game using HTML5 Canvas and ES6 modules",
  "main": "src/js/main.js",
  "type": "module",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "dev": "http-server -p 8080 -c-1 -o",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "build": "npm run lint && npm run test",
    "serve": "npm run start"
  },
  "keywords": [
    "asteroids",
    "game",
    "html5",
    "canvas",
    "javascript",
    "es6",
    "arcade"
  ],
  "author": "Asteroids Game Developer",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/asteroids-game.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/asteroids-game/issues"
  },
  "homepage": "https://github.com/yourusername/asteroids-game#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["jest-canvas-mock/lib/index.js"],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleFileExtensions": ["js"],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/js/**/*.js",
      "!src/js/main.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "html", "lcov"]
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": ["eslint:recommended"],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "no-console": "off",
      "prefer-const": "error",
      "no-var": "error"
    }
  }
}